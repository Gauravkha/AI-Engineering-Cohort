        "  parts = []\n",
        "  for i in range(len(retreived_chunks[\"ids\"][0])):\n",
        "    parts.append(f\"[Source {i}]\\n{retreived_chunks['documents'][0][i]}\")\n",
        "  return \"\\n\\n---\\n\\n\".join(parts)"
