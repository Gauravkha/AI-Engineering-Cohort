    {
      "cell_type": "markdown",
      "source": [
        "Once we have the Chunk embeddings and Content available in ChromaDB. Next step is Retreival. In this step a query is give to the DB to retreive the top-k similar chunks"
      ],
      "metadata": {
        "id": "2yae_rPDm8qi"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "def retreive(collection: str, query: str, top_k: int = 5) -> list[dict] :\n",
        "      query_embeddings = embedder.encode(query)\n",
        "      results = collection.query(query_embeddings=query_embeddings, n_results=top_k)\n",
        "      return results"
      ],
      "metadata": {
        "id": "JEXT5hmevmbG"
      },
      "execution_count": 61,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "query = \"What is the Leave Policy\"\n",
        "results = retreive(collection, query)\n",
        "\n",
